;;; mode-line-test.el --- Tests for Advent mode-line formatting  -*- lexical-binding: t; -*-

(require 'advent-mode)
(require 'ert-x)
(require 'cl-lib)

(ert-deftest advent-mode-line-format-known-and-unknown ()
  (should (equal (advent--format-mode-line advent-mode-line-format '(2024 5) "✓")
                 " AoC[Y2024/D05 ✓]"))
  (should (equal (advent--format-mode-line advent-mode-line-format nil "✗")
                 " AoC[Yxxxx/Dxx ✗]")))

(ert-deftest advent-mode-line-format-numeric-day ()
  (should (equal (advent--format-mode-line "%d/%02d %s" '(2024 5) "✓")
                 "2024/05 ✓")))

(ert-deftest advent-mode-line-refreshes-on-context-changes ()
  (ert-with-temp-directory root
    (let* ((advent-root-dir root)
           (url-setup-done t)
           (day-dir (expand-file-name "year2024/day05/" root))
           (next-dir (expand-file-name "../day06/" day-dir))
           (unknown " AoC[Yxxxx/Dxx ✗]")
           (day-five " AoC[Y2024/D05 ✗]")
           (year 2024)
           (resolve (symbol-function 'advent--context-year-day))
           (lookups 0))
      (make-directory day-dir t)
      (make-directory next-dir t)
      (with-temp-buffer
        (setq default-directory root)
        (cl-letf (((symbol-function 'advent--current-year) (lambda () year))
                  ((symbol-function 'advent--cookie-status-string) (lambda () "✗"))
                  ((symbol-function 'advent--context-year-day)
                   (lambda () (cl-incf lookups) (funcall resolve))))
          (cl-flet ((check (expected new-lookups)
                      (let ((total (+ lookups new-lookups)))
                        (dotimes (_ 2)
                          (run-hook-with-args 'pre-redisplay-functions (selected-window))
                          (should (equal (advent--mode-line) expected))
                          (should (= lookups total))))))
            (save-window-excursion
              (set-window-buffer nil (current-buffer))
              (advent-mode 1)
              (should (= lookups 1))
              (check unknown 0)
              (setq default-directory day-dir)
              ;; Only the redisplay hook should pick up the new directory.
              (should (equal (advent--mode-line) unknown))
              (check day-five 1)
              (setq buffer-file-name (expand-file-name "solution.el" next-dir))
              (check " AoC[Y2024/D06 ✗]" 1)
              (setq buffer-file-name (expand-file-name "solution.el" day-dir))
              (check day-five 1)
              (let ((advent-root-dir day-dir))
                (check unknown 1))
              (check day-five 1)
              (let ((advent-year-dir-format "y%d"))
                (check unknown 1))
              (check day-five 1)
              (let ((advent-day-dir-format "d%02d"))
                (check unknown 1))
              (check day-five 1)
              (setq year 2023)
              (check unknown 1)
              (setq year 2024)
              (check day-five 1)
              (let ((advent-mode-line-format "%d/%02d %s"))
                (check "2024/05 ✗" 0)))))))))

(ert-deftest advent-mode-line-disable-clears-context-and-hook ()
  (with-temp-buffer
    (let ((url-setup-done t)
          (lookups 0))
      (cl-letf (((symbol-function 'advent--context-year-day)
                 (lambda () (cl-incf lookups) '(2024 5))))
        (advent-mode 1)
        (advent-mode -1)
        (should-not (memq #'advent--refresh-mode-line-context pre-redisplay-functions))
        (advent-mode 1)
        (should (= lookups 2))))))

(provide 'mode-line-test)
;;; mode-line-test.el ends here
